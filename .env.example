# ---------------------------------------------------------------
# Configuration de l'application (lue par docker compose)
# Copier ce fichier en .env puis adapter les valeurs.
# ---------------------------------------------------------------

# Port exposé sur la machine hôte (http://localhost:APP_PORT)
APP_PORT=3000

# Chaîne de connexion MongoDB.
# Standalone (partie I) :
MONGO_URI=mongodb://mongodb:27017/gestion_projet
# Replica set (partie II), exemple :
# MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/gestion_projet?replicaSet=rs0
# Cluster shardé via les routeurs mongos (partie II), exemple :
# MONGO_URI=mongodb://mongos1:27017,mongos2:27017/gestion_projet

# Taille max du pool de connexions MongoDB
MONGO_MAX_POOL_SIZE=20

# Secret de signature des jetons JWT (mettre une longue valeur aléatoire)
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h

# Crée des entreprises de démonstration si la base est vide (true / false)
SEED_DEMO=true
